---
/*
 * Wordmark — `oriz` in Bricolage Grotesque with an indigo refraction beam
 * crossing the `z`: the optics-bench signature, a single ray entering and a
 * faint spectrum leaving. Links to https://oriz.in in chrome per family
 * convention.
 */

interface Props {
  subtitle?: string
  size?: number
  href?: string | null
  asHeading?: boolean
}

const { subtitle, size = 24, href = 'https://oriz.in', asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
---

{
  href ? (
    <a class="wm-link" href={href} aria-label={subtitle ? `oriz / ${subtitle}` : 'oriz.in'}>
      <Tag class="wm" style={`--wm-size: ${size}px;`}>
        <span class="wm-mark">oriz<span class="wm-tick" aria-hidden="true" /></span>
        {subtitle && (
          <>
            <span class="wm-sep" aria-hidden="true">/</span>
            <span class="wm-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wm" style={`--wm-size: ${size}px;`}>
      <span class="wm-mark">oriz<span class="wm-tick" aria-hidden="true" /></span>
      {subtitle && (
        <>
          <span class="wm-sep" aria-hidden="true">/</span>
          <span class="wm-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wm-link { display: inline-block; color: inherit; text-decoration: none; }
  .wm {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--wm-size, 24px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .wm-mark { position: relative; display: inline-block; }
  /* Refraction beam crossing the z — enters indigo, exits as a thin spectrum. */
  .wm-tick {
    position: absolute;
    right: -0.28em;
    top: 50%;
    width: 0.62em;
    height: 0.14em;
    background: linear-gradient(
      90deg,
      var(--frontier) 0 45%,
      var(--spec-2) 62%,
      var(--spec-3) 80%,
      var(--spec-4) 100%
    );
    transform: translateY(-50%) rotate(-24deg);
    transform-origin: left center;
    border-radius: 1px;
    pointer-events: none;
  }
  .wm-link:hover .wm-tick { filter: drop-shadow(0 0 4px color-mix(in oklab, var(--frontier) 55%, transparent)); }
  .wm-sep { color: var(--ink-mute); font-weight: 400; }
  .wm-sub {
    color: var(--frontier);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.62em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: center;
  }
</style>
