---
/*
 * Header — a calibration rail. Wordmark (links oriz.in) + site mark left; nav
 * tabs right; a mono status line below carrying the domain, the live risk-free
 * rate, and the reading date — the vernacular of an instrument's status strip.
 */
import assetsData from '~/data/assets.json'
import Wordmark from '~/components/Wordmark.astro'

const rf = assetsData._meta.risk_free_rate ?? 0.068
const asOf = assetsData._meta.as_of ?? ''
const DOMAIN = 'portfolio-lab.oriz.in'

const nav = [
  { href: '/questionnaire/', label: 'Profile' },
  { href: '/portfolio/', label: 'Studio' },
  { href: '/methodology/', label: 'Method' },
  { href: '/account/', label: 'Account' },
  { href: '/about/', label: 'About' },
]
---

<header class="hd">
  <div class="hd-bar spine">
    <div class="hd-brand">
      <Wordmark href="https://oriz.in" size={22} />
      <span class="hd-div" aria-hidden="true">/</span>
      <a href="/" class="hd-site">portfolio&nbsp;lab</a>
    </div>
    <nav class="hd-nav" aria-label="Site navigation">
      {nav.map((n) => (
        <a href={n.href} class="hd-tab">{n.label}</a>
      ))}
    </nav>
  </div>
  <div class="hd-strip spine">
    <span class="hd-readout">{DOMAIN}</span>
    <span class="hd-readout hd-rf">Rf = <span class="num">{(rf * 100).toFixed(1)}%</span> · G-Sec 10Y</span>
    <span class="hd-readout hd-asof">as of <span class="num">{asOf}</span></span>
  </div>
  <hr class="hairline" />
</header>

<style>
  .hd { background: color-mix(in oklab, var(--plane) 86%, transparent); backdrop-filter: blur(6px); }
  .hd-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding-block: 0.5rem;
    flex-wrap: wrap;
  }
  .hd-brand { display: inline-flex; align-items: baseline; gap: 0.55rem; }
  .hd-div { color: var(--ink-mute); font-family: var(--font-display); font-weight: 400; }
  .hd-site {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .hd-site:hover { color: var(--frontier); }

  .hd-nav { display: inline-flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; }
  .hd-tab {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding: 0.35rem 0.6rem;
    border: 1px solid transparent;
    border-radius: 3px;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .hd-tab:hover {
    color: var(--frontier);
    border-color: color-mix(in oklab, var(--frontier) 40%, transparent);
    background: color-mix(in oklab, var(--frontier) 7%, transparent);
  }

  .hd-strip {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.4rem 0.55rem;
  }
  .hd-readout {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .hd-rf .num { color: var(--frontier); }

  @media (max-width: 560px) {
    .hd-tab { padding: 0.3rem 0.45rem; font-size: 11px; }
    .hd-strip { gap: 0.9rem; }
  }
</style>
