---
import FrontierPlot from '~/components/FrontierPlot.astro'
import marketData from '~/data/market.json'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { inr, pct } from '~/lib/format'
import { SITE_CONFIG } from '~/lib/siteConfig'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE_CONFIG.name} — oriz`,
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  publisher: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://oriz.in' },
}

const strips = [
  {
    label: 'Nifty 50',
    value:
      marketData.nifty50 != null
        ? marketData.nifty50.toLocaleString('en-IN', { maximumFractionDigits: 2 })
        : '—',
  },
  { label: 'Gold ₹/10g', value: marketData.gold_inr_10g != null ? inr(marketData.gold_inr_10g) : '—' },
  { label: 'USD/INR', value: marketData.usdinr != null ? marketData.usdinr.toFixed(2) : '—' },
  { label: '10Y G-Sec', value: marketData.gsec10y != null ? pct(marketData.gsec10y) : '—' },
]
---

<BaseLayout
  title={`${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`}
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
>
  {/* Hero — the plot IS the thesis */}
  <section class="hero spine" aria-label="Risk versus return, and the max-Sharpe portfolio">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="axis-label">the efficient frontier · plotter</p>
        <h1 class="hero-h">
          The best portfolio isn't the one with the highest return. It's the one on this line.
        </h1>
        <p class="hero-sub">
          Plot Indian equity, global value, gold, REITs and debt in risk/return space. The
          capital-market line from the risk-free rate picks the mix with the most return per
          unit of risk — the max-Sharpe portfolio. Every assumption shows its forward return,
          volatility, and honest downside.
        </p>
        <div class="hero-cta">
          <a href="/questionnaire/" class="btn-primary">Plot my portfolio</a>
          <a href="/portfolio/" class="btn-secondary">Skip to the studio</a>
        </div>
      </div>
      <div class="hero-plot panel">
        <FrontierPlot />
      </div>
    </div>
  </section>

  {/* Market readout */}
  <section class="strip-section spine" aria-label="Live market levels">
    <p class="strip-label mono">Instrument readout · {marketData._meta.updated}</p>
    <ul class="strip" role="list">
      {strips.map((s) => (
        <li class="strip-item">
          <span class="strip-name mono">{s.label}</span>
          <span class="strip-val num">{s.value}</span>
        </li>
      ))}
    </ul>
    <p class="strip-note mono">
      Levels refresh nightly. Forward-return assumptions are reviewed by hand — never
      extrapolated from a bull market.
    </p>
  </section>

  {/* How it works — a real 3-step sequence, so numbering earns its place */}
  <section class="how-section spine" aria-label="How it works">
    <p class="axis-label">the run</p>
    <ol class="how-list" role="list">
      <li class="how-item panel">
        <span class="how-num mono">01</span>
        <div class="how-body">
          <strong>Set your risk</strong>
          <p>14 questions on horizon, income stability, and drawdown tolerance map you to a profile. Answers stay in your browser.</p>
        </div>
      </li>
      <li class="how-item panel">
        <span class="how-num mono">02</span>
        <div class="how-body">
          <strong>Plot the frontier</strong>
          <p>The engine samples 4,000 portfolios and returns the one on the tangent line — highest Sharpe. Drag any weight; the plot and stats recompute live.</p>
        </div>
      </li>
      <li class="how-item panel">
        <span class="how-num mono">03</span>
        <div class="how-body">
          <strong>Read the downside</strong>
          <p>Bear / base / bull bands plus a 1,000-path Monte Carlo cone. Assets below the 12% floor and P2P are flagged coral with sourced caveats.</p>
        </div>
      </li>
    </ol>
  </section>

  {/* Honesty layer */}
  <section class="honesty-section spine" aria-label="What we don't hide">
    <p class="axis-label">what we don't hide</p>
    <ul class="honesty-list">
      <li class="panel">
        <strong>Only Indian equity clears the 12% forward floor.</strong>
        International equity is ~5% INR net; gold's trailing 43% is a one-off 2025 rally
        (honest ~11%); P2P's advertised 10-18% is gross/pre-default — realistic net 6-10%.
      </li>
      <li class="panel">
        <strong>Equity drawdowns are real.</strong>
        Flexi/mid/small-cap carry 40-60% peak-to-trough loss over a full cycle. The projection
        chart draws this as the bear band, not a footnote.
      </li>
      <li class="panel">
        <strong>P2P has structural risk.</strong>
        RBI (Aug-2024) banned assured-return marketing, credit guarantees, and secondary-market
        liquidity. The lender bears 100% of default loss. No deposit guarantee.
      </li>
    </ul>
    <a href="/methodology/" class="link-text mono">Full methodology and sources &rarr;</a>
  </section>

  {/* Disclaimer */}
  <section class="disclaimer-section spine" aria-label="Disclaimer">
    <p class="disclaimer mono">
      Not investment advice. Forward returns are estimates; markets can fall 40-60%. Not
      SEBI-registered. Educational only. Do your own research.
      <a href="/legal/disclaimer/">Full disclaimer &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 0.85fr 1.15fr; }
  }
  .hero-h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 4.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 1.1rem;
    max-width: 18ch;
  }
  .hero-sub {
    font-size: 1.02rem;
    line-height: 1.62;
    color: var(--ink-mute);
    margin: 0 0 1.75rem;
    max-width: 54ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-plot { padding: clamp(0.75rem, 2vw, 1.25rem); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding-inline: 1.6rem;
    background: var(--frontier);
    color: var(--plane);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--frontier);
    border-radius: 8px;
    transition: background 0.12s, box-shadow 0.12s, transform 0.12s;
  }
  .btn-primary:hover {
    background: var(--frontier-deep);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--frontier) 20%, transparent);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding-inline: 1.4rem;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    border-radius: 8px;
    transition: border-color 0.12s, color 0.12s;
  }
  .btn-secondary:hover { border-color: var(--frontier); color: var(--frontier); }

  /* Market readout */
  .strip-section { padding-block: 1.5rem; border-bottom: 1px solid var(--rule); }
  .strip-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.9rem;
  }
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
  }
  .strip-item { display: flex; align-items: baseline; gap: 0.6rem; }
  .strip-name {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }
  .strip-val {
    font-size: 16px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-feature-settings: 'tnum' 1, 'zero' 1, 'calt' 0;
  }
  .strip-note { font-size: 10px; letter-spacing: 0.06em; color: var(--ink-mute); margin: 0; max-width: 68ch; }

  /* How it works */
  .how-section { padding-block: clamp(2.25rem, 5vw, 3rem); border-bottom: 1px solid var(--rule); }
  .how-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 760px) { .how-list { grid-template-columns: repeat(3, 1fr); } }
  .how-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
  }
  .how-num {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--frontier);
    font-weight: 500;
    padding-top: 0.15em;
  }
  .how-body strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .how-body p { margin: 0; color: var(--ink-mute); font-size: 0.9rem; line-height: 1.6; }

  /* Honesty */
  .honesty-section { padding-block: clamp(2.25rem, 5vw, 3rem); border-bottom: 1px solid var(--rule); }
  .honesty-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }
  @media (min-width: 820px) { .honesty-list { grid-template-columns: repeat(3, 1fr); } }
  .honesty-list li {
    padding: 1.1rem 1.25rem;
    color: var(--ink-mute);
    font-size: 0.9rem;
    line-height: 1.6;
    border-left: 2px solid var(--flag);
  }
  .honesty-list strong { display: block; color: var(--ink); font-weight: 600; margin-bottom: 0.35rem; }
  .link-text {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--frontier);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--frontier) 40%, transparent);
    text-underline-offset: 3px;
  }
  .link-text:hover { text-decoration-color: var(--frontier); }

  /* Disclaimer */
  .disclaimer-section { padding-block: 1.5rem 2.5rem; }
  .disclaimer { font-size: 11px; letter-spacing: 0.05em; color: var(--ink-mute); margin: 0; max-width: 76ch; line-height: 1.6; }
  .disclaimer a { color: var(--ink-mute); text-decoration: underline; text-underline-offset: 3px; }
  .disclaimer a:hover { color: var(--frontier); }
</style>
