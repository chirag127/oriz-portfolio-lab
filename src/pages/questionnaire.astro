---
import Questionnaire from '~/components/Questionnaire'
import BaseLayout from '~/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Risk questionnaire — Portfolio Lab"
  description="Answer 14 questions to determine your risk profile, then see a personalised max-Sharpe allocation."
>
  <div class="spine page-head">
    <p class="eyebrow mono">Step 1 of 2</p>
    <h1>Risk questionnaire</h1>
    <p class="lede">
      14 questions on horizon, income, drawdown tolerance, and experience. Takes ~3 minutes.
      Your answers stay in your browser — nothing is sent anywhere.
    </p>
  </div>
  <div class="spine qwrap">
    <Questionnaire client:load />
  </div>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.75rem;
  }
  .qwrap {
    padding-block: 2rem 4rem;
  }
</style>
