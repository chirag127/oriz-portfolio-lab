# oriz-portfolio-lab — public env (Vite PUBLIC_* only; no secrets)
# Copy to .env.local for dev. All values are client-exposed by design.

# Clerk auth (auth owner; cross-subdomain SSO across *.oriz.in)
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Firebase — Firestore ONLY (Clerk owns auth). User data keyed by Clerk user id.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudflare Web Analytics (optional)
PUBLIC_ENABLE_CF_ANALYTICS=
PUBLIC_CF_BEACON_TOKEN=
